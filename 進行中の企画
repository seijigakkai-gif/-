<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>進行中の企画 - 政治学会</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>進行中の企画</h1>
            <a href="index.html" class="back-link">← ホームに戻る</a>
        </header>
        <main>
            <!-- 企画を追加する入力フォーム -->
            <div class="add-project-section">
                <input type="text" id="new-project-title" placeholder="新しい企画名を入力（例：新歓準備）">
                <button id="add-btn" class="btn btn-small">追加</button>
            </div>
            
            <!-- 企画一覧が表示されるリスト -->
            <ul id="project-list" class="project-list">
                <!-- JavaScriptでここにリストが自動追加されます -->
            </ul>
        </main>
    </div>
    
    <!-- 動作を制御するスクリプトを読み込み -->
    <script src="app.js"></script>
</body>
</html>
